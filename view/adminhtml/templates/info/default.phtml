<?php
/**
 * Admin order payment info block for Payflex.
 * Uses Block/Info.php label map — raw keys are never shown.
 */

$labelMap = [
    'orderId'           => __('Payflex Order ID'),
    'orderStatus'       => __('Payflex Status'),
    'merchantReference' => __('Order Reference'),
    'amount'            => __('Amount'),
    'currency'          => __('Currency'),
];

$hiddenKeys = ['cartId', 'guestEmail', 'method_title', 'token', 'expire', 'url'];

$additionalInfo = $block->getInfo()->getAdditionalInformation();
?>

<p><strong><?php echo $block->escapeHtml($block->getMethod()->getTitle()) ?></strong></p>

<?php if (!empty($additionalInfo)): ?>
<table class="data-table">
<?php foreach ($additionalInfo as $_key => $_value): ?>
    <?php if (in_array($_key, $hiddenKeys, true) || is_array($_value) || is_object($_value)) continue; ?>
    <?php $_label = $labelMap[$_key] ?? __(ucwords(str_replace('_', ' ', $_key))); ?>
    <tr>
        <th style="text-align:left; padding-right:12px"><?php echo $block->escapeHtml($_label) ?></th>
        <td><?php echo $block->escapeHtml($_value) ?></td>
    </tr>
<?php endforeach; ?>
</table>
<?php endif; ?>

<?php echo $block->getChildHtml() ?>
