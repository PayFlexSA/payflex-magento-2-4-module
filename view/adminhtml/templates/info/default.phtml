<?php
/**
 * Admin order payment info block for the Payflex gateway.
 *
 * All data preparation lives in Block/Info.php — this template only renders
 * what the block exposes. Sensitive keys (token, url, customer email, ...) are
 * filtered out in the block and never reach here.
 *
 * The block is split into two tabs:
 *   - "Overview"          — the everyday, read-only payment details.
 *   - "Verify & Reconcile" — the occasional sanity-check tools (confirm the
 *                            live Payflex status, reconcile the order to match).
 * Separating them keeps the reconcile actions out of the everyday view and
 * signals they are not something to run routinely.
 *
 * The tab switching and status panel call the admin endpoints via plain
 * fetch() / DOM APIs (no RequireJS dependency) so it behaves identically
 * across Magento 2.4.2 - 2.4.9.
 *
 * @var \Payflex\Gateway\Block\Info $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Magento\Framework\Escaper $esc */
$esc = isset($escaper) ? $escaper : $block;

$method        = $block->getMethod();
$methodTitle   = $method ? $method->getTitle() : 'Payflex';
$transactionId = $block->getTransactionId();
$status        = $block->getPayflexStatus();
$verified      = $block->getVerifiedStatus();
$orderId       = $block->getOrderEntityId();
$processedAt   = $block->getProcessedAt();
$checkedAt     = $block->getStatusCheckedAt();
$primaryRows   = $block->getPrimaryRows();
$extraRows     = $block->getAdditionalRows();
$refunds       = $block->getRefunds();
$hasOrder      = $orderId !== null;
$isEmpty       = $transactionId === null && $status === null && empty($primaryRows) && empty($extraRows);
?>
<div class="payflex-info" id="payflex-info">
    <div class="payflex-info__header">
        <img class="payflex-info__logo"
             src="<?= $esc->escapeUrl($block->getLogoUrl()) ?>"
             alt="<?= $esc->escapeHtmlAttr($methodTitle) ?>" />
    </div>

    <?php if ($hasOrder): ?>
        <div class="payflex-info__tabs" role="tablist">
            <button type="button" class="payflex-info__tab is-active"
                    data-payflex-tab="overview">
                <?= $esc->escapeHtml(__('Overview')) ?>
            </button>
            <button type="button" class="payflex-info__tab"
                    data-payflex-tab="verify">
                <?= $esc->escapeHtml(__('Verify & Reconcile')) ?>
            </button>
        </div>
    <?php endif; ?>

    <div class="payflex-info__panel is-active" data-payflex-panel="overview">
        <table class="data-table admin__table-secondary payflex-info__table">
            <tbody>
            <?php if (false): # We don't need to show this on the overview tab?>
            <?php if ($status !== null || $hasOrder): ?>
                <tr>
                    <th class="payflex-info__th"><?= $esc->escapeHtml(__('Payflex Status')) ?></th>
                    <td class="payflex-info__td">
                        <span class="payflex-status <?= $esc->escapeHtmlAttr($block->getStatusClass($status)) ?>"
                              data-payflex-status>
                            <?= $esc->escapeHtml($status !== null ? $status : __('Unknown')) ?>
                        </span>
                        <?php if ($block->getRefundPillLabel() !== null): ?>
                            <span class="payflex-status payflex-status--refunded"
                                  title="<?= $esc->escapeHtmlAttr(__('Refunded %1', $block->getFormattedRefundedTotal())) ?>">
                                <?= $esc->escapeHtml($block->getRefundPillLabel()) ?>
                            </span>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endif; ?>
            <?php endif; ?>
            
            <?php if ($block->getOrderStatusLabel() !== null): ?>
                <tr>
                    <th class="payflex-info__th"><?= $esc->escapeHtml(__('Order Status')) ?></th>
                    <td class="payflex-info__td" data-order-status><?= $esc->escapeHtml($block->getOrderStatusLabel()) ?></td>
                </tr>
            <?php endif; ?>
            <?php if ($transactionId !== null): ?>
                <tr>
                    <th class="payflex-info__th"><?= $esc->escapeHtml(__('Transaction ID')) ?></th>
                    <td class="payflex-info__td payflex-info__td--mono"><?= $esc->escapeHtml($transactionId) ?></td>
                </tr>
            <?php endif; ?>
            <?php foreach ($primaryRows as $row): ?>
                <tr>
                    <th class="payflex-info__th"><?= $esc->escapeHtml(__($row['label'])) ?></th>
                    <td class="payflex-info__td"><?= $esc->escapeHtml($row['value']) ?></td>
                </tr>
            <?php endforeach; ?>
            <?php if ($processedAt !== null): ?>
                <tr>
                    <th class="payflex-info__th"><?= $esc->escapeHtml(__('Processed')) ?></th>
                    <td class="payflex-info__td"><?= $esc->escapeHtml($processedAt) ?></td>
                </tr>
            <?php endif; ?>
            <?php if ($block->getModuleVersion() !== null): ?>
                <tr>
                    <th class="payflex-info__th"><?= $esc->escapeHtml(__('Plugin Version')) ?></th>
                    <td class="payflex-info__td"><?= $esc->escapeHtml($block->getModuleVersion()) ?></td>
                </tr>
            <?php endif; ?>
            </tbody>
        </table>

        <?php if (!empty($refunds)): ?>
            <div class="payflex-info__refunds">
                <span class="payflex-info__refunds-title">
                    <?= $esc->escapeHtml(__('Refunds')) ?>
                    (<?= $esc->escapeHtml($block->getFormattedRefundedTotal()) ?>)
                </span>
                <table class="data-table admin__table-secondary payflex-info__table">
                    <tbody>
                    <?php foreach ($refunds as $refund): ?>
                        <tr>
                            <th class="payflex-info__th"><?= $esc->escapeHtml($refund['date']) ?></th>
                            <td class="payflex-info__td">
                                <?= $esc->escapeHtml($refund['amount_formatted'] !== null ? $refund['amount_formatted'] : __('N/A')) ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>

        <?php if (!empty($extraRows)): ?>
            <table class="data-table admin__table-secondary payflex-info__table payflex-info__table--extra">
                <tbody>
                <?php foreach ($extraRows as $row): ?>
                    <tr>
                        <th class="payflex-info__th"><?= $esc->escapeHtml(__($row['label'])) ?></th>
                        <td class="payflex-info__td"><?= $esc->escapeHtml($row['value']) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>

        <?php if ($isEmpty): ?>
            <p class="payflex-info__empty"><?= $esc->escapeHtml(__('No Payflex transaction details are available yet.')) ?></p>
        <?php endif; ?>
    </div>

    <?php if ($hasOrder): ?>
        <div class="payflex-info__panel" data-payflex-panel="verify">
            <p class="payflex-info__hint">
                <?= $esc->escapeHtml(__('Shows the payment status Payflex last reported (manually). Use Confirm Payflex Status to fetch the latest directly from Payflex.')) ?>
            </p>

            <div class="payflex-info__status-panel">
                <div class="payflex-info__status-line">
                    <span class="payflex-info__status-key"><?= $esc->escapeHtml(__('Payflex Gateway Status')) ?>:</span>
                    <span class="payflex-status <?= $esc->escapeHtmlAttr($block->getStatusClass($verified)) ?>"
                          data-payflex-status>
                        <?= $esc->escapeHtml($verified !== null ? $verified : __('Unknown')) ?>
                    </span>
                </div>
                <?php if ($block->getOrderStatusLabel() !== null): ?>
                    <div class="payflex-info__status-line">
                        <span class="payflex-info__status-key"><?= $esc->escapeHtml(__('Order Status')) ?>:</span>
                        <span data-order-status><?= $esc->escapeHtml($block->getOrderStatusLabel()) ?></span>
                    </div>
                <?php endif; ?>
                <div class="payflex-info__status-line payflex-info__checked-at" data-payflex-checked-line
                     <?= $checkedAt === null ? 'style="display:none;"' : '' ?>>
                    <span class="payflex-info__status-key"><?= $esc->escapeHtml(__('Last checked')) ?>:</span>
                    <span data-payflex-checked-at><?= $esc->escapeHtml($checkedAt !== null ? $checkedAt : '') ?></span>
                </div>
            </div>

            <div class="payflex-info__actions">
                <button type="button" class="action-secondary" data-payflex-check>
                    <?= $esc->escapeHtml(__('Confirm Payflex Status')) ?>
                </button>
                <button type="button" class="action-primary payflex-info__update-btn"
                        data-payflex-update style="display:none;">
                    <?= $esc->escapeHtml(__('Update Order to Match')) ?>
                </button>
            </div>
            <div class="payflex-info__message" data-payflex-message style="display:none;"></div>
        </div>
    <?php endif; ?>

    <?= $block->getChildHtml() ?>
</div>

<?php if ($hasOrder): ?>
<script>
(function () {
    var root = document.getElementById('payflex-info');
    if (!root || root.dataset.payflexBound) {
        return;
    }
    root.dataset.payflexBound = '1';

    var checkUrl   = <?= /* @noEscape */ json_encode($block->getCheckStatusUrl()) ?>;
    var updateUrl  = <?= /* @noEscape */ json_encode($block->getUpdateStatusUrl()) ?>;
    var formKey    = <?= /* @noEscape */ json_encode($block->getFormKey()) ?>;

    var checkBtn    = root.querySelector('[data-payflex-check]');
    var updateBtn   = root.querySelector('[data-payflex-update]');
    var messageBox  = root.querySelector('[data-payflex-message]');
    var statusEls   = root.querySelectorAll('[data-payflex-status]');
    var orderEls    = root.querySelectorAll('[data-order-status]');
    var checkedEls  = root.querySelectorAll('[data-payflex-checked-at]');
    var checkedLine = root.querySelector('[data-payflex-checked-line]');

    var STATUS_CLASSES = ['payflex-status--approved', 'payflex-status--declined', 'payflex-status--pending'];

    // Tab switching.
    var tabs = root.querySelectorAll('[data-payflex-tab]');
    var panels = root.querySelectorAll('[data-payflex-panel]');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            var target = tab.getAttribute('data-payflex-tab');
            tabs.forEach(function (t) { t.classList.toggle('is-active', t === tab); });
            panels.forEach(function (p) {
                p.classList.toggle('is-active', p.getAttribute('data-payflex-panel') === target);
            });
        });
    });

    function classForStatus(status) {
        switch (String(status || '').toLowerCase()) {
            case 'approved':
                return 'payflex-status--approved';
            case 'declined':
            case 'abandoned':
            case 'cancelled':
            case 'canceled':
            case 'failed':
                return 'payflex-status--declined';
            default:
                return 'payflex-status--pending';
        }
    }

    function showMessage(text, state) {
        if (!messageBox) {
            return;
        }
        var modifier = 'payflex-info__message--error';
        if (state === 'ok' || state === true) {
            modifier = 'payflex-info__message--ok';
        } else if (state === 'warning') {
            modifier = 'payflex-info__message--warning';
        }
        messageBox.textContent = text;
        messageBox.style.display = '';
        messageBox.className = 'payflex-info__message ' + modifier;
    }

    function applyResult(data) {
        if (data.payflex_status) {
            statusEls.forEach(function (el) {
                el.textContent = data.payflex_status;
                STATUS_CLASSES.forEach(function (c) { el.classList.remove(c); });
                el.classList.add(classForStatus(data.payflex_status));
            });
        }
        if (data.order_status_label) {
            orderEls.forEach(function (el) { el.textContent = data.order_status_label; });
        }
        if (data.checked_at) {
            checkedEls.forEach(function (el) { el.textContent = data.checked_at; });
            if (checkedLine) {
                checkedLine.style.display = '';
            }
        }
        if (updateBtn) {
            updateBtn.style.display = data.mismatch ? '' : 'none';
        }
    }

    function busy(btn, isBusy, idleText) {
        if (!btn) {
            return;
        }
        btn.disabled = isBusy;
        btn.textContent = isBusy ? '<?= $esc->escapeJs(__('Working...')) ?>' : idleText;
    }

    function request(url, body) {
        var opts = { method: body ? 'POST' : 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' } };
        if (body) {
            opts.headers['Content-Type'] = 'application/x-www-form-urlencoded';
            opts.body = body;
        }
        return fetch(url, opts).then(function (r) { return r.json(); });
    }

    if (checkBtn) {
        checkBtn.addEventListener('click', function () {
            busy(checkBtn, true);
            request(checkUrl).then(function (data) {
                busy(checkBtn, false, '<?= $esc->escapeJs(__('Confirm Payflex Status')) ?>');
                applyResult(data);
                showMessage(data.message || '', data.success ? (data.mismatch ? 'warning' : 'ok') : 'error');
            }).catch(function () {
                busy(checkBtn, false, '<?= $esc->escapeJs(__('Confirm Payflex Status')) ?>');
                showMessage('<?= $esc->escapeJs(__('Could not reach Payflex. Please try again.')) ?>', false);
            });
        });
    }

    if (updateBtn) {
        updateBtn.addEventListener('click', function () {
            if (!window.confirm('<?= $esc->escapeJs(__('Update this order to match the Payflex status? This may create an invoice or cancel the order.')) ?>')) {
                return;
            }
            busy(updateBtn, true);
            request(updateUrl, 'form_key=' + encodeURIComponent(formKey)).then(function (data) {
                busy(updateBtn, false, '<?= $esc->escapeJs(__('Update Order to Match')) ?>');
                applyResult(data);
                showMessage(data.message || '', data.success ? (data.mismatch ? 'warning' : 'ok') : 'error');
            }).catch(function () {
                busy(updateBtn, false, '<?= $esc->escapeJs(__('Update Order to Match')) ?>');
                showMessage('<?= $esc->escapeJs(__('The order could not be updated. Please try again.')) ?>', false);
            });
        });
    }
})();
</script>
<?php endif; ?>

