?>
<script>
(function () {
    var container = document.getElementById('payflex-cron-tool');
    if (!container || container.dataset.payflexBound) {
        return;
    }
    container.dataset.payflexBound = '1';

    var formKey = <?= /* @noEscape */ json_encode($formKeyProvider->getFormKey()) ?>;

    function busy(btn, isBusy, idleText) {
        btn.disabled = isBusy;
        btn.textContent = isBusy ? 'Working...' : idleText;
    }

    function showResult(row, text, ok) {
        var box = row.querySelector('.payflex-check-result');
        if (!box) {
            return;
        }
        box.textContent = text;
        box.style.display = 'block';
        box.className = 'payflex-check-result ' + (ok ? 'payflex-check-result--ok' : 'payflex-check-result--error');
    }

    function summary(data) {
        var parts = [];
        if (data.payflex_status) {
            parts.push('Payflex: ' + data.payflex_status);
        }
        if (data.message) {
            parts.push(data.message);
        }
        return parts.join(' — ') || 'Done.';
    }

    function refreshStatusBadge(row, statusCode) {
        if (!statusCode) {
            return;
        }
        var badge = row.querySelector('.status-badge');
        if (!badge) {
            return;
        }
        // Mirror the server render: the badge shows the raw status code and its
        // colour comes from a status-<code> class.
        badge.textContent = statusCode;
        badge.className = 'status-badge status-' + String(statusCode).toLowerCase().replace(/_/g, '-');
    }

    container.addEventListener('click', function (e) {
        var checkBtn = e.target.closest ? e.target.closest('.payflex-check-status') : null;
        var updateBtn = e.target.closest ? e.target.closest('.payflex-update-status') : null;

        if (checkBtn) {
            e.preventDefault();
            handleCheck(checkBtn);
        } else if (updateBtn) {
            e.preventDefault();
            handleUpdate(updateBtn);
        }
    });

    function handleCheck(btn) {
        var row = btn.closest('tr');
        busy(btn, true, 'Check Status');
        fetch(btn.getAttribute('data-check-url'), {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).then(function (r) { return r.json(); }).then(function (data) {
            busy(btn, false, 'Check Status');
            showResult(row, summary(data), data.success);
            var updateBtn = row.querySelector('.payflex-update-status');
            if (updateBtn) {
                updateBtn.style.display = data.mismatch ? '' : 'none';
            }
        }).catch(function () {
            busy(btn, false, 'Check Status');
            showResult(row, 'Could not reach Payflex. Please try again.', false);
        });
    }

    function handleUpdate(btn) {
        if (!window.confirm('Update this order to match the Payflex status? This may create an invoice or cancel the order.')) {
            return;
        }
        var row = btn.closest('tr');
        busy(btn, true, 'Update Order');
        fetch(btn.getAttribute('data-update-url'), {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'form_key=' + encodeURIComponent(formKey)
        }).then(function (r) { return r.json(); }).then(function (data) {
            busy(btn, false, 'Update Order');
            showResult(row, summary(data), data.success);
            refreshStatusBadge(row, data.order_status);
            if (data.success && !data.mismatch) {
                btn.style.display = 'none';
            }
        }).catch(function () {
            busy(btn, false, 'Update Order');
            showResult(row, 'The order could not be updated. Please try again.', false);
        });
    }
})();
</script>
